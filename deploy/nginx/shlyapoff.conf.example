# Replace example.com, certificate paths and /opt/shlyapoff before enabling this file.
limit_req_zone $binary_remote_addr zone=shlyapoff_general:10m rate=20r/s;
log_format shlyapoff_timing '$remote_addr $request $status $body_bytes_sent '
                            'rt=$request_time urt=$upstream_response_time';

server {
    listen 80;
    server_name example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name example.com;

    ssl_certificate /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    access_log /var/log/nginx/shlyapoff.access.log shlyapoff_timing;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;

    location /images/ {
        alias /opt/shlyapoff/uploads/;
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
    }

    location ~ ^/(css|js|img)/ {
        proxy_pass http://127.0.0.1:8080;
        expires 1h;
        add_header Cache-Control "public, max-age=3600, must-revalidate" always;
    }

    location /actuator/ {
        return 404;
    }

    location / {
        limit_req zone=shlyapoff_general burst=40 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 2s;
        proxy_read_timeout 30s;
    }
}
